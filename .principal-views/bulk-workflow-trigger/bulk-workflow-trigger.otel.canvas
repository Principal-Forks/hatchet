{
  "pv": {
    "name": "Bulk Workflow Trigger",
    "version": "1.0.0",
    "markdown": ".principal-views/bulk-workflow-trigger/bulk-workflow-trigger.md",
    "edgeTypes": {
      "sequence": {
        "label": "then",
        "color": "#666666"
      },
      "error": {
        "label": "on error",
        "color": "#E74C3C"
      }
    }
  },
  "nodes": [
    {
      "id": "bulk-trigger-started",
      "type": "otel-event",
      "x": 100,
      "y": 50,
      "width": 200,
      "height": 100,
      "color": "#9B59B6",
      "label": "Bulk Trigger Started",
      "description": "Bulk workflow trigger operation initiated",
      "event": {
        "name": "bulk.trigger.started",
        "attributes": {
          "hatchet.workflow_name": {
            "type": "string",
            "description": "Name of workflow being triggered",
            "required": true
          },
          "hatchet.tenant_id": {
            "type": "string",
            "description": "Tenant UUID",
            "required": true
          },
          "hatchet.bulk_count": {
            "type": "integer",
            "description": "Number of workflows being triggered",
            "required": true
          }
        }
      },
      "otel": {
        "files": [
          "sdks/typescript/src/opentelemetry/instrumentor.ts"
        ]
      },
      "pv": {
        "status": "implemented",
        "references": [
          "sdks/typescript/src/opentelemetry/instrumentor.ts"
        ]
      }
    },
    {
      "id": "bulk-trigger-complete",
      "type": "otel-event",
      "x": 100,
      "y": 250,
      "width": 200,
      "height": 100,
      "color": "#8E44AD",
      "label": "Bulk Trigger Complete",
      "description": "All workflows triggered successfully",
      "event": {
        "name": "bulk.trigger.complete",
        "attributes": {
          "hatchet.workflow_name": {
            "type": "string",
            "description": "Name of workflow that was triggered",
            "required": true
          },
          "hatchet.bulk_count": {
            "type": "integer",
            "description": "Number of workflows triggered",
            "required": true
          }
        }
      },
      "otel": {
        "files": [
          "sdks/typescript/src/opentelemetry/instrumentor.ts"
        ]
      },
      "pv": {
        "status": "implemented",
        "references": [
          "sdks/typescript/src/opentelemetry/instrumentor.ts"
        ]
      }
    },
    {
      "id": "bulk-trigger-error",
      "type": "otel-event",
      "x": 400,
      "y": 50,
      "width": 200,
      "height": 100,
      "color": "#E74C3C",
      "label": "Bulk Trigger Failed",
      "description": "Bulk workflow trigger failed",
      "event": {
        "name": "bulk.trigger.error",
        "attributes": {
          "hatchet.workflow_name": {
            "type": "string",
            "description": "Name of workflow that failed",
            "required": true
          },
          "error.type": {
            "type": "string",
            "description": "Error class/type name",
            "required": true
          },
          "error.message": {
            "type": "string",
            "description": "Error message",
            "required": true
          }
        }
      },
      "otel": {
        "files": [
          "sdks/typescript/src/opentelemetry/instrumentor.ts"
        ]
      },
      "pv": {
        "status": "implemented",
        "references": [
          "sdks/typescript/src/opentelemetry/instrumentor.ts"
        ]
      }
    }
  ],
  "edges": [
    {
      "id": "started-to-complete",
      "fromNode": "bulk-trigger-started",
      "fromSide": "bottom",
      "toNode": "bulk-trigger-complete",
      "toSide": "top",
      "pv": {
        "edgeType": "sequence"
      }
    },
    {
      "id": "started-to-error",
      "fromNode": "bulk-trigger-started",
      "fromSide": "right",
      "toNode": "bulk-trigger-error",
      "toSide": "left",
      "pv": {
        "edgeType": "error"
      }
    }
  ]
